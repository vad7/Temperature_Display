.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.cache
compile_commands.json

# --- Python ---
__pycache__/
*.pyc

# --- work/: в репозитории - docs_txt/ (текст даташитов). Не нужно: выход скриптов, логи, разовые патчи ---
work/png/
